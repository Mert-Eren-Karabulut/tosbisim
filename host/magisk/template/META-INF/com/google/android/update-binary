#!/sbin/sh
# Standard Magisk module installer stub: hand over to Magisk's own installer.
umask 022
OUTFD=$2
ZIPFILE=$3
ui_print() { echo "$1"; }
mount /data 2>/dev/null
[ -f /data/adb/magisk/util_functions.sh ] || { ui_print "! Magisk v20.4+ required"; exit 1; }
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -lt 20400 ] && { ui_print "! Magisk v20.4+ required"; exit 1; }
install_module
exit 0
