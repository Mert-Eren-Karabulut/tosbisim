<?xml version="1.0" encoding="utf-8"?>
<!-- SIM Relay host app. Copyright (C) 2026 SIM Relay authors. GPL-3.0-or-later.
     Installed as a privileged system app by the Magisk module (host/magisk). Every privileged
     permission requested here MUST be listed in host/magisk/privapp-permissions-dev.simrelay.host.xml:
     this ROM enforces it (ro.control_privapp_permissions=enforce) and refuses to boot otherwise. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- privileged: lets Telecom bind our non-UI InCallService (the BCR technique) -->
    <uses-permission android:name="android.permission.CONTROL_INCALL_EXPERIENCE" />
    <!-- privileged: Wi-Fi hotspot with internet sharing (TetheringManager) and reading its SSID/passphrase -->
    <uses-permission android:name="android.permission.TETHER_PRIVILEGED" />
    <uses-permission android:name="android.permission.OVERRIDE_WIFI_CONFIG" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- normal / runtime (granted with pm grant by the module) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- api.tosbisim.com: opt-in compatibility reports, live support table -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Dual SIM: per-SIM status (ICCID, switched-off SIMs) and settings (data roaming, data SIM, SIM on/off) -->
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <!-- Box mode: settings (AOD, wake gestures, scans, location); WRITE_SETTINGS is an app-op the module allows -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- The box-mode escape gesture opens the setup checklist from the background -->
    <uses-permission android:name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />

    <!-- Only simrelayd (root) sends these broadcasts; no other app can hold a signature permission of ours. -->
    <permission android:name="dev.simrelay.host.permission.DAEMON" android:protectionLevel="signature" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Do Not Disturb access (granted by service.sh): keep total silence after setting stream volumes -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Android 11: the pre-12 Bluetooth permissions (advertising + GATT server) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Pre-root check: is Magisk installed? -->
    <queries>
        <package android:name="com.topjohnwu.magisk" />
        <!-- Box mode blocks their network -->
        <package android:name="com.google.android.gms" />
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name">

        <service
            android:name=".HostService"
            android:exported="false" />

        <!-- Setup checklist: the host app's only screen (setup, and after the box-mode escape gesture). -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Non-UI in-call service: no IN_CALL_SERVICE_UI meta-data, so the stock dialer stays the UI. -->
        <service
            android:name=".CallMonitor"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <!-- Box mode: the host app holds the dialer role so the stock in-call screen never starts. This UI
             service draws nothing; it also "rings" (IN_CALL_SERVICE_RINGING), so Telecom plays no ringtone. -->
        <service
            android:name=".SilentInCallUi"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_RINGING" android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
        <!-- Dialer role requirement: something answers ACTION_DIAL. Nothing to show on a box. -->
        <activity
            android:name=".DialActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>
        <receiver android:name=".UpdateReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".DaemonEventReceiver"
            android:exported="true"
            android:permission="dev.simrelay.host.permission.DAEMON">
            <intent-filter>
                <action android:name="dev.simrelay.host.BOX_ESCAPE" />
                <action android:name="dev.simrelay.host.DAEMON_UP" />
            </intent-filter>
        </receiver>

        <!-- Default SMS app (role android.app.role.SMS, assigned by the Magisk module). -->
        <receiver
            android:name=".SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".MmsWapPushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".ComposeSmsActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>
        <service
            android:name=".RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>
        <receiver
            android:name=".SmsSender$SentReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.simrelay.host.SMS_SENT" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".SmsSender$DeliveredReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.simrelay.host.SMS_DELIVERED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
